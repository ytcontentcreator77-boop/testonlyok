{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testonlyok",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot", "/hooks/*", "/setup/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id on purpose: the first deploy creates this database in your Cloudflare account, and later
      // deploys reuse the one already attached to the Worker (matched by this name). The Worker creates its tables itself.
      "database_name": "Sotereamittesgtesg",
      "migrations_dir": "migrations","database_id": "5a7a076d-5085-4cd1-afbb-cbc46d68cae3"
    }
  ],
  // Every minute: command menus and broadcasts; every 3 minutes the provider order status backup check,
  // every 5 minutes the channel re-check for referrals.
  // At minute :07 of each hour it also runs cleanup (old webhook events, stale pending payments).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Optional: comma-separated Telegram user IDs that are always admins. More admins can be claimed or added in the app.
    "OWNER_IDS": "7062424671",
    // Local development only (set in .dev.vars). Must stay empty in production.
    "DEV_FAKE_USER_ID": "7430104292"
  }
}
